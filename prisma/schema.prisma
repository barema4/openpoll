// OpenPool (CeleMoney) — Prisma schema
// See /Users/samrubarema/.claude/plans/floating-inventing-kernighan.md for design rationale.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth / RBAC
// ---------------------------------------------------------------------------

model User {
  id                   String              @id @default(uuid())
  email                String              @unique
  passwordHash         String              @map("password_hash")
  name                 String
  // Paystack subaccount code for this user's own payout destination — lets an
  // individual with no Organization still receive money via personal invoices.
  // Set only via the bank-account onboarding flow (POST /payouts/resolve-account
  // + PATCH /users/me/payout) — never accepted as a raw value from a client.
  gatewayWalletId      String?             @map("gateway_wallet_id")
  payoutBankName       String?             @map("payout_bank_name")
  payoutAccountName    String?             @map("payout_account_name")
  payoutAccountLast4   String?             @map("payout_account_last4")
  // ISO-3166-1 alpha-2 country code (e.g. "KE", "UG") — determines which
  // payment provider/currency this user's personal invoices use, via
  // SUPPORTED_COUNTRIES (src/config/supported-countries.ts). Same idea as
  // Organization.country, just at the individual level since personal
  // invoicing needs no organization at all. Was a closed OrganizationCountry
  // enum (KENYA|UGANDA) until the worldwide payment-layer redesign — a plain
  // string plus a code-level lookup table means a new country is a config
  // entry, not a schema migration.
  country              String              @default("KE")
  payoutMobileProvider String?             @map("payout_mobile_provider")
  payoutMobileNumber   String?             @map("payout_mobile_number")
  // Platform-operator access (reconciliation, staff management) — distinct
  // from OrgRole, which is scoped per-organization. Null means a regular
  // user with no admin access at all. See resolve-effective-platform-role.ts
  // for the operator-email bootstrap fallback layered on top of this.
  platformRole         PlatformRole?       @map("platform_role")
  createdAt            DateTime            @default(now()) @map("created_at")

  memberships          OrganizationMembership[]
  auditLogs            AuditLog[]
  personalInvoices     PersonalInvoice[]
  passwordResetTokens  PasswordResetToken[]
  sentInvitations      OrganizationInvitation[]
  sentStaffInvitations PlatformStaffInvitation[]
  allocations          Allocation[]
  requestedWithdrawals Withdrawal[]
  manualTransactions   Transaction[]
  requestedRefunds     Refund[]
  agencyClientAccess   AgencyClientAccess[]

  @@map("users")
}

enum PlatformRole {
  OWNER
  STAFF
}

enum OrgRole {
  MAIN_ORGANIZER
  TREASURER
  AUDITOR
}

model OrganizationMembership {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           OrgRole
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("organization_memberships")
}

// ---------------------------------------------------------------------------
// Organizations / Events
// ---------------------------------------------------------------------------

enum OrganizationType {
  CHURCH
  CHAMA
  SACCO
  COLLECTIVE
  // Cosmetic only (icon/label on the dashboard) — agency mode below (see
  // AgencyClientLink) works for any organization type, not just this one.
  EVENT_COMPANY
  OTHER
}

model Organization {
  id                   String              @id @default(uuid())
  name                 String
  type                 OrganizationType
  // ISO-3166-1 alpha-2 country code — determines which payment
  // provider/currency this org's events use, via SUPPORTED_COUNTRIES
  // (src/config/supported-countries.ts). Was a closed OrganizationCountry
  // enum (KENYA|UGANDA) until the worldwide payment-layer redesign; see
  // User.country's comment for why this is a plain string now.
  country              String              @default("KE")
  // Auto-provisioned the first time a user hits "Quick collection" instead of
  // setting up a real multi-member organization — lets a solo user create an
  // event/link without an org-creation step, while everything downstream
  // (RBAC, payouts) still works exactly as it does for a real organization.
  isPersonal           Boolean             @default(false) @map("is_personal")
  // Kenya/Paystack payout destination. Set only via the bank-account onboarding
  // flow (PATCH /organizations/:id/payout).
  gatewayWalletId      String?             @map("gateway_wallet_id")
  payoutBankName       String?             @map("payout_bank_name")
  payoutAccountName    String?             @map("payout_account_name")
  payoutAccountLast4   String?             @map("payout_account_last4")
  // Uganda/PawaPay payout destination. PawaPay has no subaccount-style opaque
  // token — the raw number must be kept to place a withdrawal payout later.
  // Set only via PATCH /organizations/:id/payout-mobile-money; always masked
  // to the last 4 digits in API responses.
  payoutMobileProvider String?             @map("payout_mobile_provider")
  payoutMobileNumber   String?             @map("payout_mobile_number")
  // Shown instead of the platform's own badge on public checkout pages
  // (pay/pledge) — set only via PATCH /organizations/:id/branding. A plain
  // URL, same convention as Event.coverImageUrl — no upload pipeline exists
  // in this app.
  logoUrl              String?             @map("logo_url")
  createdAt            DateTime            @default(now()) @map("created_at")

  // Agency plan billing (Stripe subscriptions) — gates linking more than one
  // client org via AgencyClientLink; the first client is always free. Stripe
  // is the source of truth (see BillingModule); agencyPlanExpiresAt is a
  // read-optimized cache of the subscription's current_period_end, updated
  // by StripeWebhookProcessor. Null/past = no active plan.
  stripeCustomerId    String?   @unique @map("stripe_customer_id")
  agencyPlanExpiresAt DateTime? @map("agency_plan_expires_at")

  memberships             OrganizationMembership[]
  events                  Event[]
  invitations             OrganizationInvitation[]
  withdrawals             Withdrawal[]
  vendors                 Vendor[]
  budgetTemplates         BudgetTemplate[]
  relatedPersonalInvoices PersonalInvoice[]

  // Agency mode: this org manages the client orgs on the "AgencyLinks" side,
  // and/or is itself managed by an agency on the "ClientLinks" side (at most
  // one, per AgencyClientLink.clientOrganizationId's uniqueness). Access
  // grants mirror the same two directions — see AgencyClientAccess.
  managedClients       AgencyClientLink[]   @relation("AgencyLinks")
  managingAgencyLink   AgencyClientLink?    @relation("ClientLinks")
  grantsMadeAsAgency   AgencyClientAccess[] @relation("AgencyGrants")
  accessGrantsAsClient AgencyClientAccess[] @relation("ClientGrants")

  @@map("organizations")
}

// One agency org manages a client org — a client can only ever be managed by
// one agency at a time, keeping "who's responsible for this client"
// unambiguous. Existence of this row alone grants no individual access; see
// AgencyClientAccess for that.
model AgencyClientLink {
  id                   String   @id @default(uuid())
  agencyOrganizationId String   @map("agency_organization_id")
  clientOrganizationId String   @unique @map("client_organization_id")
  createdAt            DateTime @default(now()) @map("created_at")

  agencyOrganization Organization @relation("AgencyLinks", fields: [agencyOrganizationId], references: [id], onDelete: Cascade)
  clientOrganization Organization @relation("ClientLinks", fields: [clientOrganizationId], references: [id], onDelete: Cascade)

  @@map("agency_client_links")
}

// Explicit grant: this agency staff member may access this specific client
// org, at this role — checked by OrgRolesGuard as a fallback when there's no
// direct OrganizationMembership. No row here means no access; being a member
// of the agency does not by itself grant access to any client (per-client,
// per-staff-member access is deliberate, not inherited from the agency role).
model AgencyClientAccess {
  id                   String   @id @default(uuid())
  agencyOrganizationId String   @map("agency_organization_id")
  clientOrganizationId String   @map("client_organization_id")
  userId               String   @map("user_id")
  role                 OrgRole
  // Not a relation — matches Disbursement.initiatedBy/approvedBy's
  // convention for "who performed this administrative action" fields.
  grantedByUserId      String   @map("granted_by_user_id")
  createdAt            DateTime @default(now()) @map("created_at")

  agencyOrganization Organization @relation("AgencyGrants", fields: [agencyOrganizationId], references: [id], onDelete: Cascade)
  clientOrganization Organization @relation("ClientGrants", fields: [clientOrganizationId], references: [id], onDelete: Cascade)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientOrganizationId])
  @@map("agency_client_access")
}

enum EventStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

model Event {
  id                 String      @id @default(uuid())
  organizationId     String?     @map("organization_id")
  title              String
  description        String?
  coverImageUrl      String?     @map("cover_image_url")
  targetGoal         Decimal?    @map("target_goal") @db.Decimal(14, 2)
  // ISO 4217 code, set at creation from the organization's country (see
  // SUPPORTED_COUNTRIES) — stored explicitly rather than derived at read
  // time, so a display stays correct even if a country's provider/currency
  // mapping ever changes later.
  currency           String      @default("KES")
  isPermanent        Boolean     @default(false) @map("is_permanent")
  // Optional override of the organization's payout destination. Set only via
  // the bank-account onboarding flow (PATCH /events/:id/payout).
  gatewayWalletId    String?     @map("gateway_wallet_id")
  payoutBankName     String?     @map("payout_bank_name")
  payoutAccountName  String?     @map("payout_account_name")
  payoutAccountLast4 String?     @map("payout_account_last4")
  status             EventStatus @default(DRAFT)
  // Opt-in — off by default for a simple collection. Turn on for an event
  // with real line items to fund (e.g. a wedding), which unlocks
  // BudgetCategory allocation on this event.
  budgetingEnabled   Boolean     @default(false) @map("budgeting_enabled")
  createdAt          DateTime    @default(now()) @map("created_at")

  organization     Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  budgetCategories BudgetCategory[]
  invoices         Invoice[]
  transactions     Transaction[]
  disbursements    Disbursement[]
  auditLogs        AuditLog[]
  allocations      Allocation[]
  budgetApproval   BudgetApproval?

  @@map("events")
}

// ---------------------------------------------------------------------------
// Budget allocation
// ---------------------------------------------------------------------------

model BudgetCategory {
  id             String   @id @default(uuid())
  eventId        String   @map("event_id")
  name           String
  estimatedCost  Decimal  @default(0) @map("estimated_cost") @db.Decimal(14, 2)
  allocatedFunds Decimal  @default(0) @map("allocated_funds") @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  // Which vendor gets paid for this line item — set once a vendor is chosen
  // from the organization's directory; the "Pay" action (DisbursementsService)
  // requires this to be set and the event's budget to be FUNDED.
  vendorId String? @map("vendor_id")

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor        Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  disbursements Disbursement[]
  allocations   Allocation[]

  @@map("budget_categories")
}

// Explicit join between a settled Transaction and the BudgetCategory it funds.
// Not in the original SRS ERD, but required so BudgetCategory.allocatedFunds
// is always derivable/auditable from real inflows rather than hand-edited.
// Pool-based, not transaction-based: an event's collected money is one
// fungible pool, and an allocation just records "this much of that pool went
// to this category" — not which specific payment it came from. Simpler to
// use, and matches how a treasurer actually thinks about the money.
model Allocation {
  id                String   @id @default(uuid())
  eventId           String   @map("event_id")
  budgetCategoryId  String   @map("budget_category_id")
  amount            Decimal  @db.Decimal(14, 2)
  allocatedByUserId String?  @map("allocated_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at")

  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  budgetCategory BudgetCategory @relation(fields: [budgetCategoryId], references: [id], onDelete: Cascade)
  allocatedBy    User?          @relation(fields: [allocatedByUserId], references: [id], onDelete: SetNull)

  @@map("allocations")
}

// A reusable budget breakdown an organization can apply to any of its
// events — either hand-authored or saved from an existing event's current
// categories. Owned by an organization (not a user), so an agency's
// templates are shared across every client it manages, the same way its
// vendor roster is (see VendorsService.listForOrganization).
model BudgetTemplate {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        BudgetTemplateItem[]

  @@map("budget_templates")
}

model BudgetTemplateItem {
  id          String   @id @default(uuid())
  templateId  String   @map("template_id")
  name        String
  // Exactly one of these is set. percentage-of-goal matches how the
  // existing hardcoded wedding template already computes estimatedCost
  // (pct * event.targetGoal); fixedAmount is the fallback for a template
  // saved from an event with no targetGoal set.
  percentage  Decimal? @db.Decimal(5, 4)
  fixedAmount Decimal? @map("fixed_amount") @db.Decimal(14, 2)
  sortOrder   Int      @default(0) @map("sort_order")

  template BudgetTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("budget_template_items")
}

// ---------------------------------------------------------------------------
// Budget approval workflow — whoever builds the budget (MAIN_ORGANIZER/
// TREASURER) submits it; a TREASURER approves or declines it; once approved,
// a TREASURER "funds" it (a release gate only — the money already sits in
// the platform's pooled balance from collected transactions, nothing is
// moved here — see BudgetApprovalsService.fund). Budget-category mutations
// are locked by BudgetCategoriesService whenever status is anything other
// than DRAFT/DECLINED. One row per event; declining is the only way back to
// an editable state once submitted.
// ---------------------------------------------------------------------------

enum BudgetApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  DECLINED
  FUNDED
}

model BudgetApproval {
  id                String               @id @default(uuid())
  eventId           String               @unique @map("event_id")
  status            BudgetApprovalStatus @default(DRAFT)
  submittedByUserId String?              @map("submitted_by_user_id")
  submittedAt       DateTime?            @map("submitted_at")
  decidedByUserId   String?              @map("decided_by_user_id")
  decidedAt         DateTime?            @map("decided_at")
  declineReason     String?              @map("decline_reason")
  fundedByUserId    String?              @map("funded_by_user_id")
  fundedAt          DateTime?            @map("funded_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("budget_approvals")
}

// ---------------------------------------------------------------------------
// Invoices & permanent multi-use links
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  EXPIRED
}

// Distinguishes a treasurer/organizer-issued invoice from a contributor's
// own public, unauthenticated self-pledge — same payment machinery either
// way, but callers (listings, moderation) need to tell them apart.
enum InvoiceSource {
  ORGANIZER
  PUBLIC_PLEDGE
}

model Invoice {
  id               String        @id @default(uuid())
  eventId          String        @map("event_id")
  contributorName  String?       @map("contributor_name")
  contributorEmail String?       @map("contributor_email")
  contributorPhone String?       @map("contributor_phone")
  source           InvoiceSource @default(ORGANIZER)
  secureToken      String        @unique @map("secure_token")
  // Required for single-use invoices (expiresAt set) — the partial-payment
  // target. Null/ignored for permanent links, which are uncapped.
  amountRequested  Decimal?      @map("amount_requested") @db.Decimal(14, 2)
  // Running total of SUCCESS transactions applied to this invoice. Only
  // meaningful for single-use invoices; permanent links leave this at 0.
  amountPaid       Decimal       @default(0) @map("amount_paid") @db.Decimal(14, 2)
  // ISO 4217 code, copied from the parent event at creation — see
  // Event.currency's comment.
  currency         String        @default("KES")
  status           InvoiceStatus @default(PENDING)
  expiresAt        DateTime?     @map("expires_at")
  categoryTag      String?       @map("category_tag")
  createdAt        DateTime      @default(now()) @map("created_at")

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Transactions (settled payments)
// ---------------------------------------------------------------------------

enum PaymentRail {
  MOBILE_MONEY
  CARD
  // Money received outside the app (cash, a direct mobile money transfer)
  // and manually logged by an organizer/treasurer — see Transaction.note.
  MANUAL
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  // Set once a Refund against this transaction completes — deliberately
  // excluded from every existing SUCCESS-scoped query (budget pool,
  // withdrawal balance, receipt gating) with zero changes to those queries.
  REFUNDED
}

model Transaction {
  id                String            @id @default(uuid())
  invoiceId         String?           @map("invoice_id")
  eventId           String            @map("event_id")
  providerReference String            @unique @map("provider_reference")
  paymentRail       PaymentRail       @map("payment_rail")
  amountSettled     Decimal           @map("amount_settled") @db.Decimal(14, 2)
  // ISO 4217 code, copied from the event at settlement time — see
  // Event.currency's comment.
  currency          String            @default("KES")
  categoryTag       String?           @map("category_tag")
  status            TransactionStatus @default(PENDING)
  timestamp         DateTime          @default(now())
  // Set only for paymentRail: MANUAL — money an organizer/treasurer received
  // outside the app (cash, a direct mobile money transfer to the org's own
  // number) and logged so it still counts toward the event's collected total.
  // Deliberately excluded from WithdrawalsService.getBalance() AND
  // BudgetCategoriesService.allocate(): it was never actually deposited into
  // the platform's balance, so it must never be withdrawable, nor allocated
  // to a budget category that DisbursementsService.pay() could later send
  // out for real.
  recordedByUserId  String?           @map("recorded_by_user_id")
  note              String?           @map("note")
  // The platform's cut, charged additively on top of what the payer intended
  // to give — amountSettled is always net of this (what the org is credited).
  // Zero for paymentRail: MANUAL (no real gateway charge happened).
  platformFeeAmount Decimal           @default(0) @map("platform_fee_amount") @db.Decimal(14, 2)

  invoice    Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recordedBy User?     @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)
  refund     Refund?
  disputes   Dispute[]

  @@map("transactions")
}

// ---------------------------------------------------------------------------
// Refunds — full refunds only (no partial). One per Transaction (enforced by
// the unique transactionId below); a completed refund flips the linked
// Transaction to REFUNDED, which every existing SUCCESS-scoped query already
// excludes automatically. Mirrors Withdrawal's shape exactly.
// ---------------------------------------------------------------------------

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Refund {
  id                String       @id @default(uuid())
  transactionId     String       @unique @map("transaction_id")
  amount            Decimal      @db.Decimal(14, 2)
  status            RefundStatus @default(PENDING)
  providerReference String?      @unique @map("provider_reference")
  requestedByUserId String       @map("requested_by_user_id")
  failureReason     String?      @map("failure_reason")
  createdAt         DateTime     @default(now()) @map("created_at")
  completedAt       DateTime?    @map("completed_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  requestedBy User        @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

// ---------------------------------------------------------------------------
// Disputes / chargebacks — Kenya/Paystack only (mobile money has no
// chargeback mechanism). Visibility only in this phase: no evidence
// submission or accept/decline workflow. An open dispute never touches
// Transaction.status — the money hasn't moved yet. Only a resolution of
// "merchant-accepted" (the chargeback stands, money reversed) flips the
// linked Transaction to REFUNDED, via the same reversal logic a real refund
// uses (see TransactionsService's shared reversal helper).
// ---------------------------------------------------------------------------

enum DisputeStatus {
  AWAITING_MERCHANT_FEEDBACK
  AWAITING_BANK_FEEDBACK
  PENDING
  RESOLVED
}

model Dispute {
  id                String        @id @default(uuid())
  transactionId     String?       @map("transaction_id")
  providerReference String        @unique @map("provider_reference")
  status            DisputeStatus @default(PENDING)
  // Raw Paystack value once resolved: 'merchant-accepted' | 'declined'.
  resolution        String?
  amount            Decimal       @db.Decimal(14, 2)
  reason            String?
  createdAt         DateTime      @default(now()) @map("created_at")
  resolvedAt        DateTime?     @map("resolved_at")

  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@map("disputes")
}

// ---------------------------------------------------------------------------
// Vendors — an organization-wide directory (reused across that org's
// events), verified the same way an org's own payout account is: a bank
// account is resolved via Paystack before saving (VendorsService, mirroring
// PayoutsService.onboard()); mobile money has no resolve step, matching
// Organization's own payoutMobileProvider/payoutMobileNumber precedent —
// format-validated only. Raw account/phone numbers are kept server-side
// only (needed for the actual payout call) and masked to last-4 in API
// responses, same convention as Organization's own payout fields.
// payoutMobileProvider deliberately mirrors Organization.payoutMobileProvider
// as a plain string (not a DB enum) — validated against MOBILE_MONEY_PROVIDERS
// at the DTO layer (see payment-provider.interface.ts).
// ---------------------------------------------------------------------------

enum VendorPayoutMethod {
  BANK_ACCOUNT
  MOBILE_MONEY
}

model Vendor {
  id                      String             @id @default(uuid())
  organizationId          String             @map("organization_id")
  name                    String
  payoutMethod            VendorPayoutMethod @map("payout_method")
  payoutBankCode          String?            @map("payout_bank_code")
  payoutBankName          String?            @map("payout_bank_name")
  payoutAccountNumber     String?            @map("payout_account_number")
  payoutAccountName       String?            @map("payout_account_name")
  payoutAccountLast4      String?            @map("payout_account_last4")
  payoutMobileProvider    String?            @map("payout_mobile_provider")
  payoutMobileNumber      String?            @map("payout_mobile_number")
  payoutMobileNumberLast4 String?            @map("payout_mobile_number_last4")
  createdAt               DateTime           @default(now()) @map("created_at")

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  disbursements    Disbursement[]
  budgetCategories BudgetCategory[]

  @@map("vendors")
}

// ---------------------------------------------------------------------------
// Disbursements — VENDOR_PAYOUT is now live (Uganda/PawaPay only in this
// phase; a Kenya vendor's "Pay" action is rejected until the Paystack
// Transfer integration lands). ORGANIZER_WITHDRAWAL remains unused —
// Withdrawal is its own, already-shipped flow; unifying the two is out of
// scope here.
// ---------------------------------------------------------------------------

enum DisbursementTransferType {
  VENDOR_PAYOUT
  ORGANIZER_WITHDRAWAL
}

enum DisbursementStatus {
  PENDING
  QUEUED
  SUCCESS
  FAILED
}

model Disbursement {
  id                      String                   @id @default(uuid())
  eventId                 String                   @map("event_id")
  budgetCategoryId        String?                  @map("budget_category_id")
  vendorId                String?                  @map("vendor_id")
  transferType            DisbursementTransferType @map("transfer_type")
  recipientName           String                   @map("recipient_name")
  recipientBankCode       String?                  @map("recipient_bank_code")
  recipientAccountNumber  String?                  @map("recipient_account_number")
  recipientMobileProvider String?                  @map("recipient_mobile_provider")
  recipientMobileNumber   String?                  @map("recipient_mobile_number")
  amount                  Decimal                  @db.Decimal(14, 2)
  // The PawaPay payoutId — unique so the payout-completion webhook
  // (pawapay-webhook.controller.ts) can look a disbursement up by it,
  // exactly like Withdrawal.providerReference.
  gatewayTransferRef      String?                  @unique @map("gateway_transfer_ref")
  status                  DisbursementStatus       @default(PENDING)
  failureReason           String?                  @map("failure_reason")
  initiatedBy             String                   @map("initiated_by")
  approvedBy              String?                  @map("approved_by")
  createdAt               DateTime                 @default(now()) @map("created_at")

  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  budgetCategory BudgetCategory? @relation(fields: [budgetCategoryId], references: [id], onDelete: SetNull)
  vendor         Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@map("disbursements")
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Personal invoices — standalone "demand payment from someone" tool.
// Deliberately separate from Invoice/Event/Organization: usable by any user,
// org member or not, to bill a specific person a specific amount via a
// one-time link, sent by email/WhatsApp. Does not feed budget allocation or
// event contributor summaries.
// ---------------------------------------------------------------------------

enum PersonalInvoiceStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

model PersonalInvoice {
  id             String                @id @default(uuid())
  issuerId       String                @map("issuer_id")
  recipientName  String                @map("recipient_name")
  recipientEmail String?               @map("recipient_email")
  recipientPhone String?               @map("recipient_phone")
  description    String?
  amount         Decimal               @db.Decimal(14, 2)
  amountPaid     Decimal               @default(0) @map("amount_paid") @db.Decimal(14, 2)
  // ISO 4217 code, copied from the issuing user's country at creation — see
  // Event.currency's comment.
  currency       String                @default("KES")
  secureToken    String                @unique @map("secure_token")
  status         PersonalInvoiceStatus @default(PENDING)
  expiresAt      DateTime?             @map("expires_at")
  paidAt         DateTime?             @map("paid_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  // Purely a label — "this invoice was for planning this org's event" —
  // for an event company billing a client it manages (see AgencyClientLink).
  // Doesn't touch who's actually billed (issuer/recipient stay as-is).
  relatedOrganizationId String? @map("related_organization_id")

  issuer              User                         @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  relatedOrganization Organization?                @relation(fields: [relatedOrganizationId], references: [id], onDelete: SetNull)
  transactions        PersonalInvoiceTransaction[]

  @@map("personal_invoices")
}

model PersonalInvoiceTransaction {
  id                String            @id @default(uuid())
  personalInvoiceId String            @map("personal_invoice_id")
  providerReference String            @unique @map("provider_reference")
  paymentRail       PaymentRail       @map("payment_rail")
  amountSettled     Decimal           @map("amount_settled") @db.Decimal(14, 2)
  status            TransactionStatus @default(PENDING)
  timestamp         DateTime          @default(now())
  // The platform's cut, charged additively on top of what the payer intended
  // to give — amountSettled is always net of this.
  platformFeeAmount Decimal           @default(0) @map("platform_fee_amount") @db.Decimal(14, 2)

  personalInvoice PersonalInvoice @relation(fields: [personalInvoiceId], references: [id], onDelete: Cascade)

  @@map("personal_invoice_transactions")
}

model AuditLog {
  id              String   @id @default(uuid())
  eventId         String?  @map("event_id")
  userId          String?  @map("user_id")
  action          String
  payloadSnapshot Json?    @map("payload_snapshot")
  timestamp       DateTime @default(now())

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Password reset
// ---------------------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Organization invitations — lets a MAIN_ORGANIZER invite someone who doesn't
// have an account yet. Resolved into a real OrganizationMembership when the
// invited email completes registration with the token from the invite email.
// ---------------------------------------------------------------------------

enum OrganizationInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model OrganizationInvitation {
  id              String                       @id @default(uuid())
  organizationId  String                       @map("organization_id")
  email           String
  role            OrgRole
  invitedByUserId String                       @map("invited_by_user_id")
  tokenHash       String                       @unique @map("token_hash")
  status          OrganizationInvitationStatus @default(PENDING)
  expiresAt       DateTime                     @map("expires_at")
  createdAt       DateTime                     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@map("organization_invitations")
}

// ---------------------------------------------------------------------------
// Platform staff invitations — lets an Owner invite a company employee who
// doesn't have an account yet. Every accepted invite grants STAFF (an Owner
// promotes someone to OWNER separately, via a direct update — not through
// this flow, since there should rarely be more than one). Mirrors
// OrganizationInvitation's token/expiry/never-block-registration shape.
// ---------------------------------------------------------------------------

enum PlatformStaffInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model PlatformStaffInvitation {
  id              String                        @id @default(uuid())
  email           String
  invitedByUserId String                        @map("invited_by_user_id")
  tokenHash       String                        @unique @map("token_hash")
  status          PlatformStaffInvitationStatus @default(PENDING)
  expiresAt       DateTime                      @map("expires_at")
  createdAt       DateTime                      @default(now()) @map("created_at")

  invitedBy User @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@map("platform_staff_invitations")
}

// ---------------------------------------------------------------------------
// Withdrawals — cashing out a Uganda/PawaPay organization's accumulated
// balance. PawaPay has no charge-time routing (unlike Paystack subaccounts),
// so contributions collect in the platform's own PawaPay balance and a
// treasurer explicitly withdraws when ready.
// ---------------------------------------------------------------------------

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Withdrawal {
  id                String           @id @default(uuid())
  organizationId    String           @map("organization_id")
  amount            Decimal          @db.Decimal(14, 2)
  status            WithdrawalStatus @default(PENDING)
  providerReference String?          @unique @map("provider_reference")
  requestedByUserId String           @map("requested_by_user_id")
  failureReason     String?          @map("failure_reason")
  createdAt         DateTime         @default(now()) @map("created_at")
  completedAt       DateTime?        @map("completed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@map("withdrawals")
}
