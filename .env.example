NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://openpoll:openpoll_dev_password@localhost:5433/openpoll?schema=public"

REDIS_URL="redis://localhost:6380"

JWT_ACCESS_SECRET="replace_with_long_random_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace_with_long_random_secret"
JWT_REFRESH_EXPIRES_IN="7d"

PAYSTACK_SECRET_KEY="sk_test_changeme"
PAYSTACK_WEBHOOK_SECRET="sk_test_changeme"

PUBLIC_CHECKOUT_BASE_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"

# Optional — if unset, emails are logged to the server console instead of sent.
# Emails are queued via BullMQ (src/email/) with retries, so a Resend outage
# never blocks or fails the request that triggered the email.
RESEND_API_KEY=""
# onboarding@resend.dev only delivers to the Resend account owner's own
# address — fine for solo testing, but once you verify a real domain in the
# Resend dashboard, point this at an address on that domain so emails reach
# real recipients.
RESEND_FROM_EMAIL="OpenPool <onboarding@resend.dev>"
